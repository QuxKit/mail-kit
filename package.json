{
  "name": "@quxkit/mail-kit",
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "description": "Transactional email as a library \u2014 sending domains, idempotent sends, delivery events, suppression and signed webhooks, over a transport you choose.",
  "license": "Apache-2.0",
  "author": "BRETT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuxKit/mail-kit.git"
  },
  "homepage": "https://github.com/QuxKit/mail-kit#readme",
  "bugs": {
    "url": "https://github.com/QuxKit/mail-kit/issues"
  },
  "keywords": [
    "email",
    "transactional-email",
    "smtp",
    "ses",
    "dkim",
    "spf",
    "dmarc",
    "webhooks",
    "bounce-handling",
    "suppression",
    "resend",
    "postgres",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./ses": {
      "types": {
        "import": "./dist/ses.d.ts",
        "require": "./dist/ses.d.cts"
      },
      "import": "./dist/ses.mjs",
      "require": "./dist/ses.cjs"
    },
    "./smtp": {
      "types": {
        "import": "./dist/smtp.d.ts",
        "require": "./dist/smtp.d.cts"
      },
      "import": "./dist/smtp.mjs",
      "require": "./dist/smtp.cjs"
    },
    "./memory": {
      "types": {
        "import": "./dist/memory.d.ts",
        "require": "./dist/memory.d.cts"
      },
      "import": "./dist/memory.mjs",
      "require": "./dist/memory.cjs"
    },
    "./pg": {
      "types": {
        "import": "./dist/pg.d.ts",
        "require": "./dist/pg.d.cts"
      },
      "import": "./dist/pg.mjs",
      "require": "./dist/pg.cjs"
    },
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sql",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:coverage": "c8 tsx --test --test-concurrency=1 test/*.test.ts",
    "check:harness": "tsx -e \"import('./test/harness.ts').then(() => console.log('harness imports ok'))\"",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "c8": "^12.0.0",
    "pg": "^8.23.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
